# Default answer and curator provider: anthropic, groq or gemini (GUI can override)
MODEL_PROVIDER=anthropic

# Required only when MODEL_PROVIDER=anthropic (Sonnet answers, Haiku curation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google AI Studio / Gemini Developer API (keys stay on the server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required when MODEL_PROVIDER=groq; GROQ_MODEL handles answers and curation
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Chat request caps: input counts serialized UTF-8 bytes conservatively as tokens,
# including policy, history, search results and the tool schema. Output is separate.
# Raise only to match the input/output quotas shown in your Groq account.
GROQ_MAX_INPUT_TOKENS=6500
GROQ_MAX_OUTPUT_TOKENS=768

# Required for the single web_search tool, with either answer provider
TAVILY_API_KEY=

# Optional fallback search provider
EXA_API_KEY=

# Optional Postgres connection string; empty uses embedded PGlite at ./data/pglite
DATABASE_URL=

# User-facing timezone fallback
DEFAULT_TZ=Asia/Kolkata

# Evals only: ISO timestamp with Z or an explicit offset, e.g. 2026-11-15T12:00:00Z
NOW_OVERRIDE=
