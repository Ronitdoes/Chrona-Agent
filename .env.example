# Required for chat requests
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Optional fallback search provider
EXA_API_KEY=

# Optional Postgres connection string; empty uses embedded PGlite at ./data/pglite
DATABASE_URL=

# User-facing timezone fallback
DEFAULT_TZ=Asia/Kolkata

# Evals only: override the current instant, e.g. 2026-11-15T12:00:00Z
NOW_OVERRIDE=