# Default answer and curator provider: anthropic or gemini (GUI can override)
MODEL_PROVIDER=anthropic

# Required only when MODEL_PROVIDER=anthropic (Sonnet answers, Haiku curation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google AI Studio / Gemini Developer API (keys stay on the server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Required for the single web_search tool, with either answer provider
TAVILY_API_KEY=

# Optional fallback search provider
EXA_API_KEY=

# Required. Local Docker Postgres: npm run db:up
# These credentials are local development defaults, not production secrets.
DATABASE_URL=postgresql://chrona:chrona_local@127.0.0.1:5432/chrona

# Integration tests only: npm run db:test:up (never use your application database)
TEST_DATABASE_URL=postgresql://chrona_test:chrona_test_local@127.0.0.1:5433/chrona_test

# User-facing timezone fallback
DEFAULT_TZ=Asia/Kolkata

# Evals only: ISO timestamp with Z or an explicit offset, e.g. 2026-11-15T12:00:00Z
NOW_OVERRIDE=
