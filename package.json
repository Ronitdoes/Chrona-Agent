{
  "name": "web-agent-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "vitest run --config evals/config.mts",
    "eval:live": "vitest run --config evals/live.config.mts",
    "ship:verify": "node scripts/verify-clean-clone.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "db:test:down": "docker compose --profile test rm -s -f postgres-test",
    "search:smoke": "vitest run --config scripts/search-smoke.config.mts",
    "search:live-smoke": "vitest run --config scripts/live-search-smoke.config.mts",
    "recall:live-eval": "vitest run --config scripts/recall-live-eval.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.25",
    "better-auth": "^1.7.25",
    "chrono-node": "^2.10.3",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "p-limit": "^7.3.3",
    "p-timeout": "^8.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
